<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.nab.restrict.zero.qty</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_inventory_section']" position="inside">
                <setting id="nab_enable_pos_restrict_zero_qty"
                         string="Zero Quantity Product Validation"
                         help="Prevent sales of products with zero or negative stock levels.">
                    <field name="pos_enable_pos_restrict_zero_qty"/>
                    <div class="content-group mt16"
                         invisible="not pos_enable_pos_restrict_zero_qty">
                        <div class="row">
                            <label for="pos_enable_per_product_warning"
                                   string="Show Warning Per Product"
                                   class="col-lg-6 o_light_label"/>
                            <field name="pos_enable_per_product_warning"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
